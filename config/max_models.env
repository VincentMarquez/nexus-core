# Recorded July 2026 examples included gpt-5.6-sol, fable, and grok-4.5.
# Provider model IDs, effort values, and tiers evolve. Set only values supported
# by the installed CLI/provider; leaving these unset preserves its normal model
# selection behavior.
#
# export NEXUS_CODEX_MODEL="<supported-codex-model>"
# export NEXUS_CODEX_REASONING="<supported-reasoning-value>"
# export NEXUS_CODEX_SERVICE_TIER="<supported-service-tier>"
#
# export NEXUS_CLAUDE_MODEL="<supported-claude-model>"
# export NEXUS_CLAUDE_EFFORT="<supported-effort-value>"
#
# export NEXUS_GROK_MODEL="<supported-grok-model>"
# export NEXUS_GROK_REASONING_EFFORT="<supported-effort-value>"
export NEXUS_GROK_BRIDGE_TURNS="${NEXUS_GROK_BRIDGE_TURNS:-12}"

# Gemini (research) — leave unset for CLI default
# export NEXUS_GEMINI_MODEL="<supported-gemini-model>"

# Timeouts for heavy max models
export NEXUS_CLI_TIMEOUT_S="${NEXUS_CLI_TIMEOUT_S:-600}"
export NEXUS_MSG_TIMEOUT_MS="${NEXUS_MSG_TIMEOUT_MS:-600000}"
